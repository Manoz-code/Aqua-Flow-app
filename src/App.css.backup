
/* =========================================================
   AQUAFLOW OFFLINE - APP CSS
   Optimized for:
   - Desktop
   - Tablet
   - Android / Mobile
   - Capacitor
   - Touch screens
   - Performance
   ========================================================= */

/* =========================================================
   RESET
   ========================================================= */

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  width: 100%;
  min-height: 100%;
  margin: 0;
  padding: 0;

  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  color: #0f172a;
  background: #f1f5f9;

  font-synthesis: none;
  text-rendering: optimizeLegibility;

  -webkit-text-size-adjust: 100%;
  -webkit-tap-highlight-color: transparent;

  scroll-behavior: smooth;
}

html,
body,
#root {
  width: 100%;
  min-height: 100%;
  margin: 0;
}

body {
  min-height: 100vh;
  min-height: 100dvh;

  overflow-x: hidden;

  background: #f1f5f9;

  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

button,
input,
textarea,
select {
  font: inherit;
}

button {
  cursor: pointer;
  touch-action: manipulation;
}

button:disabled {
  cursor: not-allowed;
  opacity: 0.55;
}

input,
textarea,
select {
  outline: none;
}

img,
svg {
  max-width: 100%;
}

::selection {
  background: #bae6fd;
  color: #0c4a6e;
}

/* =========================================================
   APP
   ========================================================= */

.app {
  min-height: 100vh;
  min-height: 100dvh;

  background: #f1f5f9;
}

/* =========================================================
   HEADER
   ========================================================= */

.app-header {
  position: sticky;
  top: 0;
  z-index: 1000;

  height: 72px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding:
    0
    max(24px, env(safe-area-inset-right))
    0
    max(24px, env(safe-area-inset-left));

  background: rgba(255, 255, 255, 0.97);

  border-bottom: 1px solid #e2e8f0;

  box-shadow:
    0 2px 10px rgba(15, 23, 42, 0.05);

  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}

.header-logo {
  min-width: 0;

  display: flex;
  align-items: center;

  gap: 12px;
}

.header-logo > span {
  width: 42px;
  height: 42px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  border-radius: 12px;

  background: #e0f2fe;

  font-size: 23px;
}

.header-logo h1 {
  margin: 0;

  overflow: hidden;

  color: #0f172a;

  font-size: 20px;
  line-height: 1.2;
  font-weight: 800;

  text-overflow: ellipsis;
  white-space: nowrap;
}

.header-logo small {
  display: block;

  margin-top: 2px;

  color: #64748b;

  font-size: 11px;
}

.logout-button {
  min-height: 40px;

  flex-shrink: 0;

  padding: 0 15px;

  border: 1px solid #e2e8f0;
  border-radius: 9px;

  background: #ffffff;
  color: #475569;

  font-weight: 700;

  transition:
    background 0.15s ease,
    border-color 0.15s ease,
    color 0.15s ease;
}

.logout-button:hover {
  background: #f8fafc;
  border-color: #cbd5e1;
  color: #0f172a;
}

/* =========================================================
   APP LAYOUT
   ========================================================= */

.app-layout {
  display: flex;

  min-height: calc(100vh - 72px);
  min-height: calc(100dvh - 72px);
}

.main-content {
  flex: 1;

  min-width: 0;

  padding: 28px;
}

.page {
  width: 100%;
  max-width: 1500px;

  margin: 0 auto;
}

/* =========================================================
   SIDEBAR
   ========================================================= */

.sidebar {
  width: 235px;

  flex-shrink: 0;

  background: #ffffff;

  border-right: 1px solid #e2e8f0;

  padding: 20px 14px;
}

.sidebar nav {
  display: flex;
  flex-direction: column;

  gap: 6px;
}

.sidebar nav button {
  width: 100%;
  min-height: 46px;

  display: flex;
  align-items: center;

  gap: 12px;

  padding: 0 14px;

  border: 0;
  border-radius: 10px;

  background: transparent;
  color: #64748b;

  text-align: left;

  font-size: 14px;
  font-weight: 650;

  transition:
    background 0.15s ease,
    color 0.15s ease;
}

.sidebar nav button span {
  width: 22px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  font-size: 18px;
}

.sidebar nav button:hover {
  background: #f1f5f9;
  color: #0f172a;
}

.sidebar nav button.active {
  background: #e0f2fe;
  color: #0369a1;

  font-weight: 750;
}

.sidebar nav button.active span {
  transform: scale(1.05);
}

/* =========================================================
   PAGE HEADER
   ========================================================= */

.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 20px;

  margin-bottom: 24px;
}

.page-header h2 {
  margin: 0;

  color: #0f172a;

  font-size: 26px;
  line-height: 1.2;
  font-weight: 800;
}

.welcome {
  margin: 6px 0 0;

  color: #64748b;

  font-size: 14px;
}

/* =========================================================
   BUTTONS
   ========================================================= */

.primary-button,
.secondary-button {
  min-height: 42px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  padding: 0 16px;

  border-radius: 9px;

  font-size: 14px;
  font-weight: 700;

  transition:
    background 0.15s ease,
    border-color 0.15s ease,
    box-shadow 0.15s ease;
}

.primary-button {
  border: 1px solid #0284c7;

  background: #0284c7;
  color: #ffffff;

  box-shadow:
    0 2px 5px rgba(2, 132, 199, 0.18);
}

.primary-button:hover {
  background: #0369a1;
  border-color: #0369a1;
}

.secondary-button {
  border: 1px solid #cbd5e1;

  background: #ffffff;
  color: #334155;
}

.secondary-button:hover {
  background: #f8fafc;
  border-color: #94a3b8;
}

.primary-button:active,
.secondary-button:active {
  transform: translateY(1px);
}

/* =========================================================
   ACCESSIBILITY
   ========================================================= */

button:focus-visible,
input:focus-visible,
textarea:focus-visible,
select:focus-visible {
  outline: 3px solid rgba(2, 132, 199, 0.2);
  outline-offset: 2px;
}

/* =========================================================
   DASHBOARD
   ========================================================= */

.dashboard-cards {
  display: grid;

  grid-template-columns:
    repeat(4, minmax(0, 1fr));

  gap: 16px;

  margin-bottom: 24px;
}

.dashboard-card {
  min-width: 0;

  padding: 20px;

  background: #ffffff;

  border: 1px solid #e2e8f0;
  border-radius: 14px;

  box-shadow:
    0 2px 8px rgba(15, 23, 42, 0.04);

  transition:
    transform 0.15s ease,
    box-shadow 0.15s ease;
}

.dashboard-card:hover {
  transform: translateY(-2px);

  box-shadow:
    0 8px 20px rgba(15, 23, 42, 0.07);
}

.card-icon {
  width: 42px;
  height: 42px;

  display: flex;
  align-items: center;
  justify-content: center;

  margin-bottom: 14px;

  border-radius: 11px;

  background: #f0f9ff;

  font-size: 20px;
}

.dashboard-card h3 {
  margin: 0 0 7px;

  color: #64748b;

  font-size: 13px;
  font-weight: 650;
}

.dashboard-card p {
  margin: 0;

  color: #0f172a;

  font-size: 22px;
  line-height: 1.2;
  font-weight: 800;

  word-break: break-word;
}

/* =========================================================
   GENERAL CARD
   ========================================================= */

.customer-form-card {
  margin-bottom: 20px;
  padding: 22px;

  background: #ffffff;

  border: 1px solid #e2e8f0;
  border-radius: 14px;

  box-shadow:
    0 2px 8px rgba(15, 23, 42, 0.035);
}

.form-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  gap: 15px;

  margin-bottom: 20px;
}

.form-header h3 {
  margin: 0;

  color: #0f172a;

  font-size: 17px;
  font-weight: 800;
}

.form-header p {
  margin: 5px 0 0;

  color: #64748b;

  font-size: 13px;
}

.close-button {
  width: 34px;
  height: 34px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  border: 0;
  border-radius: 8px;

  background: #f1f5f9;
  color: #64748b;

  font-size: 22px;
  line-height: 1;
}

.close-button:hover {
  background: #e2e8f0;
  color: #0f172a;
}

/* =========================================================
   FORMS
   ========================================================= */

.form-grid {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 18px;
}

.form-group {
  min-width: 0;

  display: flex;
  flex-direction: column;

  gap: 7px;
}

.form-group-full {
  grid-column: 1 / -1;
}

.form-group label {
  color: #334155;

  font-size: 13px;
  font-weight: 700;
}

.form-group input,
.form-group select,
.form-group textarea {
  width: 100%;

  padding: 11px 13px;

  border: 1px solid #cbd5e1;
  border-radius: 9px;

  background: #ffffff;
  color: #0f172a;

  font-size: 16px;

  transition:
    border-color 0.15s ease,
    box-shadow 0.15s ease;

  -webkit-appearance: none;
  appearance: none;
}

.form-group input,
.form-group select {
  min-height: 44px;
}

.form-group textarea {
  min-height: 95px;

  resize: vertical;
}

.form-group input::placeholder,
.form-group textarea::placeholder {
  color: #94a3b8;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
  border-color: #0284c7;

  box-shadow:
    0 0 0 3px rgba(2, 132, 199, 0.1);
}

.input-help {
  color: #64748b;

  font-size: 11px;
  line-height: 1.5;
}

.form-actions {
  display: flex;
  justify-content: flex-end;
  align-items: center;

  gap: 10px;

  margin-top: 20px;
}

/* =========================================================
   SEARCH
   ========================================================= */

.customer-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 15px;

  margin-bottom: 18px;
}

.search-box {
  width: min(100%, 450px);

  min-height: 44px;

  display: flex;
  align-items: center;

  gap: 9px;

  padding: 0 13px;

  background: #ffffff;

  border: 1px solid #cbd5e1;
  border-radius: 9px;
}

.search-box:focus-within {
  border-color: #0284c7;

  box-shadow:
    0 0 0 3px rgba(2, 132, 199, 0.08);
}

.search-box span {
  flex-shrink: 0;

  font-size: 15px;
}

.search-box input {
  width: 100%;
  min-width: 0;

  border: 0;
  outline: 0;

  background: transparent;

  color: #0f172a;

  font-size: 16px;
}

.customer-count {
  color: #64748b;

  font-size: 12px;
  font-weight: 600;

  white-space: nowrap;
}

/* =========================================================
   CUSTOMER LIST
   ========================================================= */

.customers-list,
.deliveries-list {
  display: flex;
  flex-direction: column;

  gap: 12px;
}

.customer-card,
.delivery-card {
  width: 100%;
  min-width: 0;

  display: flex;
  align-items: center;

  gap: 15px;

  padding: 17px 18px;

  background: #ffffff;

  border: 1px solid #e2e8f0;
  border-radius: 13px;

  box-shadow:
    0 2px 7px rgba(15, 23, 42, 0.035);

  transition:
    box-shadow 0.15s ease,
    transform 0.15s ease;
}

.customer-card:hover,
.delivery-card:hover {
  transform: translateY(-1px);

  box-shadow:
    0 6px 16px rgba(15, 23, 42, 0.06);
}

.customer-avatar {
  width: 46px;
  height: 46px;

  flex-shrink: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: #e0f2fe;
  color: #0369a1;

  font-size: 14px;
  font-weight: 800;
}

.customer-info {
  min-width: 0;
  flex: 1;
}

.customer-info h3 {
  margin: 0 0 7px;

  color: #0f172a;

  font-size: 15px;
  font-weight: 800;

  word-break: break-word;
}

.customer-details {
  display: flex;
  align-items: center;
  flex-wrap: wrap;

  gap: 7px 15px;

  color: #64748b;

  font-size: 12px;
}

.customer-details span {
  display: inline-flex;
  align-items: center;

  gap: 3px;
}

.customer-actions {
  min-width: 0;

  display: flex;
  align-items: center;

  gap: 7px;

  flex-shrink: 1;

  flex-wrap: wrap;
}

.edit-button,
.delete-button {
  width: 40px;
  height: 40px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  border-radius: 8px;

  font-size: 15px;
}

.edit-button {
  border: 1px solid #bae6fd;

  background: #f0f9ff;
}

.edit-button:hover {
  background: #e0f2fe;
}

.delete-button {
  border: 1px solid #fecaca;

  background: #fef2f2;
}

.delete-button:hover {
  background: #fee2e2;
}

/* =========================================================
   EMPTY STATE
   ========================================================= */

.empty-state {
  padding: 55px 25px;

  text-align: center;

  background: #ffffff;

  border: 1px dashed #cbd5e1;
  border-radius: 14px;
}

.empty-icon {
  margin-bottom: 10px;

  font-size: 38px;
}

.empty-state h3 {
  margin: 0 0 7px;

  color: #0f172a;

  font-size: 17px;
}

.empty-state p {
  max-width: 430px;

  margin: 0 auto 18px;

  color: #64748b;

  font-size: 13px;
  line-height: 1.6;
}

/* =========================================================
   COMING SOON / INFO
   ========================================================= */

.coming-soon {
  padding: 30px;

  text-align: center;

  background: #ffffff;

  border: 1px solid #e2e8f0;
  border-radius: 14px;

  box-shadow:
    0 2px 8px rgba(15, 23, 42, 0.035);
}

.coming-soon-icon {
  margin-bottom: 8px;

  font-size: 32px;
}

.coming-soon h3 {
  margin: 0 0 7px;

  color: #0f172a;

  font-size: 18px;
}

.coming-soon p {
  max-width: 600px;

  margin: 0 auto;

  color: #64748b;

  font-size: 13px;
  line-height: 1.6;
}

/* =========================================================
   DELIVERY SUMMARY
   ========================================================= */

.delivery-summary {
  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 15px;

  margin-bottom: 20px;
}

.summary-card {
  display: flex;
  align-items: center;

  gap: 13px;

  padding: 17px;

  background: #ffffff;

  border: 1px solid #e2e8f0;
  border-radius: 12px;
}

.summary-card > span {
  width: 42px;
  height: 42px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  border-radius: 10px;

  background: #f0f9ff;

  font-size: 20px;
}

.summary-card div {
  min-width: 0;
}

.summary-card small {
  display: block;

  margin-bottom: 3px;

  color: #64748b;

  font-size: 11px;
}

.summary-card strong {
  display: block;

  color: #0f172a;

  font-size: 17px;

  word-break: break-word;
}

/* =========================================================
   QUANTITY PRESETS
   ========================================================= */

.preset-buttons {
  display: flex;
  flex-wrap: wrap;

  gap: 8px;

  margin-bottom: 8px;
}

.preset-button {
  min-height: 38px;

  padding: 0 13px;

  border: 1px solid #cbd5e1;
  border-radius: 8px;

  background: #ffffff;
  color: #475569;

  font-size: 13px;
  font-weight: 700;

  touch-action: manipulation;
}

.preset-button:hover {
  border-color: #7dd3fc;
  background: #f0f9ff;
}

.preset-button.selected {
  border-color: #0284c7;

  background: #e0f2fe;
  color: #0369a1;
}

/* =========================================================
   CUSTOMER PICKER
   ========================================================= */

.customer-picker {
  position: relative;
}

.customer-picker-trigger {
  width: 100%;
  min-height: 48px;

  display: flex;
  align-items: center;

  gap: 10px;

  padding: 0 13px;

  border: 1px solid #cbd5e1;
  border-radius: 9px;

  background: #ffffff;
  color: #64748b;

  text-align: left;
}

.customer-picker-trigger:hover {
  border-color: #94a3b8;
}

.picker-search-icon {
  flex-shrink: 0;
}

.customer-picker-trigger > span:nth-child(2) {
  min-width: 0;
  flex: 1;
}

.picker-arrow {
  flex-shrink: 0;

  font-size: 17px;
}

.selected-customer {
  min-height: 62px;

  display: flex;
  align-items: center;

  gap: 12px;

  padding: 9px 12px;

  border: 1px solid #bae6fd;
  border-radius: 10px;

  background: #f0f9ff;
}

.selected-customer-avatar,
.picker-avatar {
  width: 40px;
  height: 40px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  border-radius: 50%;

  background: #bae6fd;
  color: #0369a1;

  font-size: 12px;
  font-weight: 800;
}

.selected-customer-info {
  min-width: 0;
  flex: 1;

  display: flex;
  flex-direction: column;

  gap: 2px;
}

.selected-customer-info strong {
  overflow: hidden;

  color: #0f172a;

  font-size: 13px;

  text-overflow: ellipsis;
  white-space: nowrap;
}

.selected-customer-info span {
  overflow: hidden;

  color: #64748b;

  font-size: 11px;

  text-overflow: ellipsis;
  white-space: nowrap;
}

.change-customer-button {
  min-height: 34px;

  flex-shrink: 0;

  padding: 0 10px;

  border: 1px solid #bae6fd;
  border-radius: 7px;

  background: #ffffff;
  color: #0369a1;

  font-size: 12px;
  font-weight: 700;
}

.customer-picker-panel {
  position: absolute;

  z-index: 500;

  top: calc(100% + 6px);
  left: 0;
  right: 0;

  overflow: hidden;

  background: #ffffff;

  border: 1px solid #cbd5e1;
  border-radius: 12px;

  box-shadow:
    0 16px 40px rgba(15, 23, 42, 0.15);
}

.customer-picker-search {
  height: 48px;

  display: flex;
  align-items: center;

  gap: 8px;

  padding: 0 12px;

  border-bottom: 1px solid #e2e8f0;
}

.customer-picker-search input {
  flex: 1;

  min-width: 0;

  border: 0;
  outline: 0;

  color: #0f172a;

  font-size: 16px;
}

.customer-picker-search button {
  width: 30px;
  height: 30px;

  flex-shrink: 0;

  border: 0;
  border-radius: 6px;

  background: #f1f5f9;
  color: #64748b;

  font-size: 18px;
}

.customer-picker-count {
  padding: 8px 12px;

  background: #f8fafc;

  border-bottom: 1px solid #e2e8f0;

  color: #64748b;

  font-size: 11px;
  font-weight: 600;
}

.customer-picker-list {
  max-height: 310px;

  overflow-y: auto;

  overscroll-behavior: contain;
  -webkit-overflow-scrolling: touch;
}

.customer-picker-item {
  width: 100%;

  display: flex;
  align-items: center;

  gap: 11px;

  padding: 11px 12px;

  border: 0;
  border-bottom: 1px solid #f1f5f9;

  background: #ffffff;

  text-align: left;
}

.customer-picker-item:hover {
  background: #f8fafc;
}

.picker-customer-info {
  min-width: 0;
  flex: 1;
}

.picker-customer-info strong {
  display: block;

  margin-bottom: 4px;

  overflow: hidden;

  color: #0f172a;

  font-size: 13px;

  text-overflow: ellipsis;
  white-space: nowrap;
}

.picker-customer-info > div {
  display: flex;
  flex-wrap: wrap;

  gap: 5px 12px;

  color: #64748b;

  font-size: 10px;
}

.picker-check {
  flex-shrink: 0;

  color: #0284c7;

  font-size: 16px;
  font-weight: 800;
}

.picker-empty {
  padding: 35px 20px;

  text-align: center;
}

.picker-empty span {
  display: block;

  margin-bottom: 8px;

  font-size: 26px;
}

.picker-empty strong {
  display: block;

  margin-bottom: 4px;

  color: #334155;

  font-size: 13px;
}

.picker-empty p {
  margin: 0;

  color: #94a3b8;

  font-size: 11px;
}

/* =========================================================
   DELIVERY CARDS
   ========================================================= */

.delivery-card {
  width: 100%;
  min-width: 0;

  align-items: stretch;

  justify-content: space-between;
}

.delivery-main {
  width: 100%;
  min-width: 0;

  display: flex;
  align-items: flex-start;

  gap: 13px;

  flex: 1 1 auto;
}

.delivery-icon {
  width: 44px;
  height: 44px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  border-radius: 11px;

  background: #e0f2fe;

  font-size: 20px;
}

.delivery-info {
  width: 100%;
  min-width: 0;
  flex: 1 1 auto;
}

.delivery-title-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;

  gap: 8px;

  margin-bottom: 6px;
}

.delivery-title-row h3 {
  margin: 0;

  color: #0f172a;

  font-size: 15px;

  overflow-wrap: anywhere;
}

.delivery-details {
  display: flex;
  align-items: center;
  flex-wrap: wrap;

  gap: 7px 15px;

  color: #64748b;

  font-size: 12px;
}

.delivery-notes {
  margin: 8px 0 0;

  color: #64748b;

  font-size: 12px;
  line-height: 1.5;

  overflow-wrap: anywhere;
}

.status-badge {
  display: inline-flex;
  align-items: center;

  min-height: 24px;

  padding: 0 8px;

  border-radius: 999px;

  font-size: 10px;
  font-weight: 800;

  text-transform: capitalize;
}

.status-pending {
  background: #fef3c7;
  color: #92400e;
}

.status-delivered {
  background: #dcfce7;
  color: #166534;
}

.status-cancelled {
  background: #fee2e2;
  color: #991b1b;
}

.delivery-right {
  width: auto;
  min-width: 130px;

  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;

  gap: 3px;

  flex-shrink: 0;
}

.delivery-right .customer-actions {
  width: 100%;
  min-width: 0;

  display: flex;
  align-items: center;
  justify-content: flex-end;

  gap: 7px;

  flex-wrap: wrap;
}

.delivery-right > strong {
  color: #0f172a;

  font-size: 16px;

  white-space: nowrap;
}

.delivery-right > small {
  color: #94a3b8;

  font-size: 10px;
}

/* =========================================================
   DELIVERY TOTAL
   ========================================================= */

.delivery-total-preview {
  display: grid;

  grid-template-columns:
    repeat(4, minmax(0, 1fr));

  gap: 10px;

  margin-top: 20px;
  padding: 15px;

  border: 1px solid #bae6fd;
  border-radius: 11px;

  background: #f0f9ff;
}

.delivery-total-preview > div {
  min-width: 0;

  padding: 10px;

  border-radius: 8px;

  background: rgba(255, 255, 255, 0.75);
}

.delivery-total-preview span {
  display: block;

  margin-bottom: 4px;

  color: #64748b;

  font-size: 11px;
}

.delivery-total-preview strong {
  color: #0f172a;

  font-size: 14px;

  word-break: break-word;
}

.delivery-total-preview .total-highlight {
  background: #0284c7;
}

.delivery-total-preview .total-highlight span,
.delivery-total-preview .total-highlight strong {
  color: #ffffff;
}

.delivery-total-preview .total-highlight strong {
  font-size: 17px;
}

/* =========================================================
   PIN SCREEN
   ========================================================= */

.pin-screen {
  min-height: 100vh;
  min-height: 100dvh;

  display: flex;
  align-items: center;
  justify-content: center;

  padding:
    20px
    max(20px, env(safe-area-inset-right))
    20px
    max(20px, env(safe-area-inset-left));

  background:
    radial-gradient(
      circle at top,
      #e0f2fe 0%,
      #f1f5f9 45%,
      #e2e8f0 100%
    );
}

.pin-card {
  width: min(100%, 380px);

  padding: 34px 28px;

  background: #ffffff;

  border: 1px solid #e2e8f0;
  border-radius: 18px;

  box-shadow:
    0 20px 50px rgba(15, 23, 42, 0.12);

  text-align: center;
}

.pin-card .logo {
  width: 62px;
  height: 62px;

  display: flex;
  align-items: center;
  justify-content: center;

  margin: 0 auto 14px;

  border-radius: 18px;

  background: #e0f2fe;

  font-size: 32px;
}

.pin-card h1 {
  margin: 0;

  color: #0f172a;

  font-size: 25px;
  font-weight: 850;
}

.pin-card .subtitle {
  margin: 5px 0 25px;

  color: #64748b;

  font-size: 12px;
}

.pin-card h2 {
  margin: 0 0 13px;

  color: #334155;

  font-size: 15px;
}

.pin-dots {
  display: flex;
  justify-content: center;

  gap: 12px;

  margin-bottom: 12px;
}

.pin-dots .dot {
  color: #cbd5e1;

  font-size: 19px;
}

.pin-dots .dot.filled {
  color: #0284c7;
}

.pin-error {
  min-height: 18px;

  margin: 0 0 10px;

  color: #dc2626;

  font-size: 12px;
  font-weight: 700;
}

.number-pad {
  display: grid;

  grid-template-columns:
    repeat(3, 1fr);

  gap: 10px;

  margin-top: 8px;
}

.number-pad button {
  height: 55px;

  border: 1px solid #e2e8f0;
  border-radius: 10px;

  background: #f8fafc;
  color: #0f172a;

  font-size: 17px;
  font-weight: 750;

  transition:
    background 0.1s ease,
    transform 0.1s ease;
}

.number-pad button:hover {
  background: #e0f2fe;
}

.number-pad button:active {
  transform: scale(0.97);
}

.unlock-button {
  width: 100%;
  height: 46px;

  margin-top: 14px;

  border: 0;
  border-radius: 9px;

  background: #0284c7;
  color: #ffffff;

  font-size: 14px;
  font-weight: 800;
}

.unlock-button:hover:not(:disabled) {
  background: #0369a1;
}

.demo-pin {
  margin: 15px 0 0;

  color: #94a3b8;

  font-size: 11px;
}

/* =========================================================
   SCROLLBARS
   ========================================================= */

::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

::-webkit-scrollbar-track {
  background: #f1f5f9;
}

::-webkit-scrollbar-thumb {
  background: #cbd5e1;

  border-radius: 999px;
}

::-webkit-scrollbar-thumb:hover {
  background: #94a3b8;
}

/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 1100px) {
  .dashboard-cards {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .delivery-total-preview {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }
}

/* =========================================================
   TABLET / SMALL LAPTOP
   ========================================================= */

@media (max-width: 800px) {
  .app-header {
    height: 64px;

    padding-left: 15px;
    padding-right: 15px;
  }

  .app-layout {
    min-height: calc(100vh - 64px);
    min-height: calc(100dvh - 64px);
  }

  .sidebar {
    width: 72px;

    padding: 12px 8px;
  }

  .sidebar nav button {
    justify-content: center;

    padding: 0;
  }

  .sidebar nav button span {
    font-size: 19px;
  }

  .sidebar nav button {
    font-size: 0;
  }

  .main-content {
    padding: 20px 15px;
  }

  .header-logo h1 {
    font-size: 18px;
  }

  .header-logo small {
    display: none;
  }

  .page-header {
    align-items: flex-start;
  }

  .page-header h2 {
    font-size: 22px;
  }

  .form-grid {
    grid-template-columns: 1fr;
  }

  .form-group-full {
    grid-column: auto;
  }

  .delivery-summary {
    grid-template-columns: 1fr;
  }
}

/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 600px) {
  .app-header {
    padding-left: 10px;
    padding-right: 10px;
  }

  .header-logo {
    gap: 8px;
  }

  .header-logo > span {
    width: 38px;
    height: 38px;
  }

  .header-logo h1 {
    max-width: 170px;

    font-size: 17px;
  }

  .logout-button {
    min-height: 36px;

    padding: 0 10px;

    font-size: 12px;
  }

  .main-content {
    padding: 16px 10px;
  }

  .page-header {
    flex-direction: column;
    align-items: stretch;
  }

  .page-header .primary-button {
    width: 100%;
  }

  .dashboard-cards {
    grid-template-columns: 1fr;

    gap: 10px;
  }

  .dashboard-card {
    padding: 15px;
  }

  .customer-toolbar {
    flex-direction: column;
    align-items: stretch;
  }

  .search-box {
    width: 100%;
  }

  .customer-count {
    text-align: right;
  }

  .customer-card {
    align-items: flex-start;

    padding: 14px;

    flex-wrap: wrap;
  }

  .customer-info {
    width: calc(100% - 60px);
  }

  .customer-actions {
    width: 100%;

    justify-content: flex-end;

    padding-left: 58px;
  }

  /* =======================================================
     MOBILE DELIVERY FIX
     ======================================================= */

  .delivery-card {
    width: 100%;
    min-width: 0;

    flex-direction: column;
    align-items: stretch;

    gap: 12px;

    box-sizing: border-box;
  }

  .delivery-main {
    width: 100%;
    min-width: 0;
  }

  .delivery-info {
    width: 100%;
    min-width: 0;
  }

  .delivery-right {
    width: 100%;
    min-width: 0;

    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;

    gap: 8px;

    padding-top: 10px;

    border-top: 1px solid #f1f5f9;
  }

  .delivery-right > strong,
  .delivery-right > small {
    width: 100%;

    text-align: left;
  }

  .delivery-right .customer-actions {
    width: 100%;
    min-width: 0;

    display: flex;
    flex-wrap: wrap;

    align-items: stretch;
    justify-content: flex-start;

    gap: 8px;

    padding-left: 0;
  }

  .delivery-right .customer-actions > button {
    min-width: 0;

    box-sizing: border-box;

    white-space: normal;

    flex: 1 1 120px;
  }

  .delivery-right .customer-actions .edit-button,
  .delivery-right .customer-actions .delete-button {
    flex: 0 0 40px;

    width: 40px;
    min-width: 40px;
  }

  .delivery-total-preview {
    grid-template-columns: 1fr;
  }

  .form-actions {
    flex-direction: column-reverse;
  }

  .form-actions button {
    width: 100%;
  }

  .selected-customer {
    align-items: flex-start;
  }

  .change-customer-button {
    margin-left: auto;
  }

  .pin-card {
    padding: 28px 18px;
  }

  .number-pad {
    gap: 8px;
  }

  .number-pad button {
    height: 52px;
  }
}

/* =========================================================
   SMALL PHONES
   ========================================================= */

@media (max-width: 420px) {
  .sidebar {
    width: 58px;
  }

  .sidebar nav button {
    min-height: 44px;
  }

  .sidebar nav button span {
    font-size: 17px;
  }

  .main-content {
    padding: 12px 8px;
  }

  .customer-details,
  .delivery-details {
    flex-direction: column;
    align-items: flex-start;

    gap: 5px;
  }

  .header-logo h1 {
    max-width: 135px;
  }

  .logout-button {
    padding: 0 8px;
  }
}

/* =========================================================
   TOUCH DEVICES
   ========================================================= */

@media (hover: none) and (pointer: coarse) {
  .dashboard-card:hover,
  .customer-card:hover,
  .delivery-card:hover {
    transform: none;

    box-shadow:
      0 2px 8px rgba(15, 23, 42, 0.04);
  }

  .primary-button:hover,
  .secondary-button:hover,
  .logout-button:hover,
  .edit-button:hover,
  .delete-button:hover,
  .preset-button:hover,
  .customer-picker-trigger:hover,
  .customer-picker-item:hover {
    background: inherit;
  }

  .customer-picker-list {
    -webkit-overflow-scrolling: touch;
  }
}

/* =========================================================
   REDUCED MOTION
   ========================================================= */

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;

    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
  }
}

/* =========================================================
   PRINT
   ========================================================= */

@media print {
  html,
  body {
    background: #ffffff;
  }

  .app-header,
  .sidebar,
  .primary-button,
  .secondary-button,
  .customer-actions,
  .form-actions {
    display: none !important;
  }

  .app-layout {
    display: block;

    min-height: auto;
  }

  .main-content {
    padding: 0;
  }

  .page {
    max-width: none;
  }

  .customer-form-card,
  .customer-card,
  .delivery-card,
  .dashboard-card {
    box-shadow: none;

    break-inside: avoid;
  }
}

.dashboard-card-clickable {
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.dashboard-card-clickable:hover,
.dashboard-card-clickable:focus-visible {
  transform: translateY(-2px);
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
  outline: none;
}

.dashboard-card-clickable:active {
  transform: translateY(0);
}


/* =========================================================
   MOBILE NAVIGATION
   ========================================================= */

.header-left {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 0;
}

.hamburger-button {
  display: none;

  width: 42px;
  height: 42px;

  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  border: 1px solid #e2e8f0;
  border-radius: 10px;

  background: #ffffff;
  color: #0f172a;

  font-size: 22px;
  line-height: 1;
}

.sidebar-header {
  display: none;
}

.sidebar-close-button {
  border: 0;
  background: transparent;
  color: #64748b;

  width: 36px;
  height: 36px;

  border-radius: 8px;

  font-size: 24px;
}

.sidebar-overlay {
  display: none;
}

/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 768px) {
  .app-header {
    height: 62px;

    padding:
      0
      max(12px, env(safe-area-inset-right))
      0
      max(12px, env(safe-area-inset-left));
  }

  .hamburger-button {
    display: flex;
  }

  .header-logo {
    gap: 8px;
  }

  .header-logo > span {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    font-size: 19px;
  }

  .header-logo h1 {
    font-size: 17px;
  }

  .header-logo small {
    font-size: 9px;
  }

  .logout-button {
    min-height: 36px;
    padding: 0 10px;
    font-size: 12px;
  }

  .app-layout {
    min-height: calc(100dvh - 62px);
  }

  .main-content {
    width: 100%;
    padding: 14px 12px;
  }

  .sidebar {
    position: fixed;

    top: 0;
    left: 0;
    z-index: 2000;

    width: min(82vw, 280px);
    height: 100dvh;

    transform: translateX(-105%);

    transition: transform 0.2s ease;

    overflow-y: auto;

    box-shadow: 8px 0 30px rgba(15, 23, 42, 0.14);
  }

  .sidebar.sidebar-open {
    transform: translateX(0);
  }

  .sidebar-header {
    display: flex;

    align-items: center;
    justify-content: space-between;

    min-height: 62px;
    padding: 0 14px;

    border-bottom: 1px solid #e2e8f0;
  }

  .sidebar-overlay {
    display: block;

    position: fixed;
    inset: 0;

    z-index: 1999;

    width: 100%;
    height: 100%;

    border: 0;

    background: rgba(15, 23, 42, 0.35);
  }

  .sidebar nav {
    padding: 10px;
  }

  .sidebar nav button {
    min-height: 44px;
    padding: 0 12px;

    font-size: 14px;
  }

  .page {
    max-width: none;
  }
}

/* =========================================================
   MOBILE COMPACT UI
   ========================================================= */

@media (max-width: 768px) {
  .page-header {
    margin-bottom: 14px;
  }

  .page-header h2 {
    font-size: 19px;
  }

  .page-header .welcome {
    font-size: 12px;
  }

  .dashboard-cards {
    gap: 8px;
  }

  .dashboard-card {
    min-height: 86px;
    padding: 12px;
    border-radius: 12px;
  }

  .dashboard-card .card-icon {
    font-size: 20px;
  }

  .dashboard-card h3 {
    font-size: 12px;
    margin: 5px 0 2px;
  }

  .dashboard-card p {
    font-size: 15px;
  }

  .customer-form-card,
  .coming-soon {
    padding: 14px;
    border-radius: 12px;
  }

  .form-header {
    margin-bottom: 14px;
  }

  .form-header h3 {
    font-size: 15px;
  }

  .form-header p {
    font-size: 12px;
  }

  .form-grid {
    gap: 10px;
  }

  .form-group {
    gap: 5px;
  }

  .form-group label {
    font-size: 12px;
  }

  .form-group input,
  .form-group textarea,
  .form-group select {
    min-height: 42px;
    padding: 9px 10px;
    font-size: 13px;
    border-radius: 9px;
  }

  .form-group textarea {
    min-height: 80px;
  }

  .primary-button,
  .secondary-button,
  .delete-button,
  .edit-button {
    min-height: 38px;
    padding: 8px 11px;
    font-size: 12px;
    border-radius: 8px;
  }

  .customer-card,
  .delivery-card {
    padding: 11px;
    border-radius: 11px;
  }

  .customer-avatar,
  .delivery-icon {
    width: 38px;
    height: 38px;
    flex-shrink: 0;
  }

  .customer-info h3,
  .delivery-info h3 {
    font-size: 13px;
  }

  .customer-details,
  .delivery-details {
    gap: 5px;
    font-size: 11px;
  }

  .customer-actions {
    gap: 5px;
  }

  .search-box input {
    min-height: 40px;
    font-size: 13px;
  }

  .delivery-summary {
    gap: 8px;
  }

  .summary-card {
    padding: 10px;
    border-radius: 10px;
  }

  .summary-card strong {
    font-size: 14px;
  }

  .delivery-total-preview {
    padding: 10px;
    gap: 8px;
  }

  .form-actions {
    gap: 7px;
    margin-top: 14px;
  }

  .empty-state {
    padding: 28px 14px;
  }

  .empty-state h3 {
    font-size: 15px;
  }

  .empty-state p {
    font-size: 12px;
  }

  .coming-soon-icon {
    font-size: 28px;
  }
}